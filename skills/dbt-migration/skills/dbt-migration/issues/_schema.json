{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "dbt-migration issue corpus entry",
  "description": "One migration issue derived from the Migration Analysis DB. One YAML file per issue.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "issue_id",
    "sort_order",
    "change",
    "action",
    "category",
    "component",
    "adapter_type",
    "impact",
    "from_version",
    "to_version",
    "automation_type",
    "out_of_repo_risk",
    "environment_change",
    "context"
  ],
  "properties": {
    "issue_id": {
      "type": "string",
      "pattern": "^from_1\\.[3-7]_to_1\\.[4-8]_[0-9]{3}$",
      "description": "Stable identity: from_<X>_to_<Y>_<NNN> (3-digit). Never changes on reorder."
    },
    "sort_order": {
      "type": "integer",
      "minimum": 1000,
      "maximum": 5999,
      "description": "Drives processing order (ascending). Hop bands: 1.3->1.4=1000s, 1.4->1.5=2000s, 1.5->1.6=3000s, 1.6->1.7=4000s, 1.7->1.8=5000s."
    },
    "change": { "type": "string", "minLength": 1 },
    "action": { "type": "string", "minLength": 1 },
    "category": {
      "type": "string",
      "enum": ["Breaking", "Behavior", "Deprecated"]
    },
    "component": {
      "type": "string",
      "enum": ["core", "adapter"]
    },
    "adapter_type": {
      "type": ["string", "null"],
      "enum": ["snowflake", "redshift", "bigquery", "databricks", "spark", null]
    },
    "impact": { "type": "string", "minLength": 1 },
    "from_version": {
      "type": "string",
      "enum": ["1.3", "1.4", "1.5", "1.6", "1.7"]
    },
    "to_version": {
      "type": "string",
      "enum": ["1.4", "1.5", "1.6", "1.7", "1.8"]
    },
    "automation_type": {
      "type": "string",
      "enum": ["deterministic", "agentic", "human"],
      "description": "How the issue is resolved. deterministic -> dbt-autofix handles it (the skill only maps its diff + verifies). agentic -> the skill applies the fix directly, then verifies. human -> the skill proposes a fix, confirms with the user, then applies (HITL)."
    },
    "out_of_repo_risk": {
      "type": "boolean",
      "description": "true -> the fix may reach things outside the repo (job --select, selectors.yml, BI tools, mesh refs); surfaced in the results report for the user regardless of automation_type."
    },
    "environment_change": {
      "type": "boolean",
      "description": "true -> dependency / Python-runtime / profiles change. Advisory edit only, never executed, and excluded from the parse-verify loop."
    },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "required": ["detection", "fixing"],
      "properties": {
        "detection": { "type": "string", "minLength": 1 },
        "fixing": { "type": "string", "minLength": 1 }
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "component": { "const": "core" } } },
      "then": { "properties": { "adapter_type": { "const": null } } }
    },
    {
      "if": { "properties": { "component": { "const": "adapter" } } },
      "then": { "properties": { "adapter_type": { "type": "string" } } }
    }
  ]
}
